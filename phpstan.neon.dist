includes:
    - phpstan-baseline.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-execution-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-insecure-calls.neon

parameters:
    # Runs before the Laravel extension's own bootstrap, and defines the
    # version constant that extension reads without a guard. See the file.
    bootstrapFiles:
        - phpstan-bootstrap.php

    tmpDir: .cache/phpstan

    # Pinned to the range composer.json declares, because PHPStan otherwise
    # analyses at whatever PHP is running it. That made a local run and CI two
    # different analyses: CI runs 8.4, a developer may be on 8.5, and each missed
    # what the other caught. The test matrix covers both versions; so should this.
    phpVersion:
        min: 80400
        max: 80599

    paths:
        - src
        - tests
        - workbench
        - .config

    level: max

    strictRules:
        allRules: true

    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'

    type_coverage:
        return: 100
        param: 100
        property: 100
        constant: 0
        declare: 100

    type_perfect:
        null_over_false: true
        narrow_return: true

    cognitive_complexity:
        class: 80
        function: 20

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        -
            identifier: trait.unused
            reportUnmatched: false
        # Pest's expectation API is marked @internal but is the intended public
        # surface for tests. Allow calling it from our tests/.
        -
            identifier: method.internalClass
            paths:
                - tests/*
            reportUnmatched: false
